[node name="Instructions" type="RichTextLabel" parent="HowToPlayModal/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 13
bbcode_enabled = true
text = "[color=#a0d8ef]Movement:[/color] Use [b]WASD[/b] or [b]Arrow Keys[/b] to navigate corridors.

[color=#a0d8ef]Attack & Combat:[/color] Press [b]Spacebar[/b], [b]Left Click[/b], or [b]J[/b] to execute 3-hit sword combos and defeat enemy Shinobis!

[color=#a0d8ef]Coins & Score:[/color] Collect floating [color=#ffd700]Gold Coins[/color] (+100 pts) scattered throughout corridors to maximize your score!

[color=#a0d8ef]Goal:[/color] Reach the [color=#ffd700]Golden Exit Portal[/color] as fast as possible.

[color=#a0d8ef]Shortcuts:[/color]
• [b]Q[/b] - Return to Main Menu
• [b]N[/b] - Load Next Level
• [b]ESC[/b] - Pause / Return to Main Menu"

